<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TgMini.Desktop"
        x:Class="TgMini.Desktop.MainWindow"
        Title="TG Mini" Width="860" Height="600" MinWidth="420" MinHeight="380"
        Background="#0E1621"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterScreen">

    <Grid RowDefinitions="*,Auto">
        <!-- Главная рабочая область -->
        <Grid Grid.Row="0" x:Name="MainGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="0"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА: Папки, Поиск, Список чатов -->
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Background="#17212B">
                <!-- Папки -->
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="8,8,8,4">
                    <StackPanel x:Name="FolderBar" Orientation="Horizontal" Spacing="4"/>
                </ScrollViewer>

                <!-- Поиск -->
                <Border Grid.Row="1" Background="#242F3D" CornerRadius="14" Margin="8,4,8,8" Padding="6,2">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#708499" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <TextBox Grid.Column="1" x:Name="SearchBox" Watermark="Поиск..."
                                 Background="Transparent" Foreground="#F5F5F5"
                                 BorderThickness="0" Padding="4,5" FontSize="12"/>
                        <Button Grid.Column="2" x:Name="SearchClearBtn" Content="✕" Width="20" Height="20" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#708499" BorderThickness="0"
                                IsVisible="False" Click="SearchClearBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Список диалогов -->
                <ListBox Grid.Row="2" x:Name="DialogList"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Single">
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="Margin" Value="4,1"/>
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                            <Setter Property="Background" Value="#1E2936"/>
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                            <Setter Property="Background" Value="#243343"/>
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:DialogRow">
                            <Grid ColumnDefinitions="42,*" Margin="4,2">
                                <!-- Круглая аватарка -->
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" ClipToBounds="True" VerticalAlignment="Center">
                                    <Panel>
                                        <Border Background="{Binding AvatarColor}">
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontWeight="Bold" FontSize="13"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <Image Source="{Binding AvatarPath, Converter={x:Static local:ThumbConverter.Instance}, ConverterParameter=48}"
                                               Stretch="UniformToFill"
                                               IsVisible="{Binding AvatarVisible}"/>
                                    </Panel>
                                </Border>

                                <!-- Имя, время, превью, бейдж, мут, закреп -->
                                <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="{Binding NameWeight}"
                                               Foreground="#F5F5F5" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Time}" Foreground="#708499" FontSize="11" Margin="4,0,0,0"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Preview}" Foreground="#7F8C99" FontSize="12"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,4,0"/>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,3,0,0">
                                        <TextBlock Text="🔇" FontSize="10" Foreground="#708499" IsVisible="{Binding MutedVisible}"/>
                                        <TextBlock Text="📌" FontSize="11" Foreground="#2EA6FF" IsVisible="{Binding PinnedVisible}"/>
                                        <Border Background="{Binding BadgeBackground}" CornerRadius="9" MinWidth="18" Height="18"
                                                Padding="5,0" VerticalAlignment="Center" IsVisible="{Binding BadgeVisible}">
                                            <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="10" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Column="1" Background="#0E1621"/>

            <!-- ПРАВАЯ КОЛОНКА: Чат -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,Auto" Background="#0E1621">
                <!-- Шапка чата -->
                <Border Grid.Row="0" Background="#17212B" Padding="12,8" BorderBrush="#0E1621" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Button Grid.Column="0" x:Name="TogglePanelBtn" Content="☰"
                                Width="32" Height="32" Padding="0" Margin="0,0,10,0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#242F3D" Foreground="#F5F5F5" BorderThickness="0" CornerRadius="6"
                                Click="TogglePanel_Click" ToolTip.Tip="Компактный режим (скрыть чаты)"/>

                        <!-- Аватарка чата в шапке -->
                        <Border Grid.Column="1" x:Name="HeaderAvatar" Width="36" Height="36" CornerRadius="18" ClipToBounds="True"
                                Margin="0,0,10,0" VerticalAlignment="Center" IsVisible="False">
                            <Panel>
                                <Border x:Name="HeaderAvatarBg" Background="#2EA6FF">
                                    <TextBlock x:Name="HeaderAvatarInitials" Text="TG" Foreground="White" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Image x:Name="HeaderAvatarPhoto" Stretch="UniformToFill" IsVisible="False"/>
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="ChatTitle" Text="Выберите чат" FontWeight="SemiBold" FontSize="15" Foreground="#F5F5F5"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="ChatSub" Text="" FontSize="11" Foreground="#708499"
                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Лента сообщений + плавающая кнопка Вниз -->
                <Panel Grid.Row="1">
                    <ScrollViewer x:Name="FeedScroll" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="FeedPanel" Margin="12,8" Spacing="4">
                            <Button x:Name="LoadMoreBtn" Content="⬆ Загрузить более ранние сообщения"
                                    HorizontalAlignment="Center" Background="#242F3D" Foreground="#2EA6FF"
                                    BorderThickness="0" CornerRadius="6" Padding="12,6" FontSize="11"
                                    IsVisible="False" Click="LoadMore_Click"/>
                            <ItemsControl x:Name="FeedList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:MsgRow">
                                        <StackPanel Margin="0,2">
                                            <!-- Центрированный разделитель даты -->
                                            <Border Background="#17212B" CornerRadius="10" Padding="12,3"
                                                    HorizontalAlignment="Center" Margin="0,4,0,6"
                                                    IsVisible="{Binding DateSeparatorVisible}">
                                                <TextBlock Text="{Binding DateSeparator}" Foreground="#7F8C99" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Бабл -->
                                            <Border CornerRadius="{Binding BubbleRadius}" Padding="10,7" Margin="0,1" MaxWidth="520"
                                                    Background="{Binding Bubble}"
                                                    HorizontalAlignment="{Binding Align}">
                                                <StackPanel Spacing="3">
                                                    <!-- Автор (в группах) -->
                                                    <TextBlock Text="{Binding Author}" Foreground="{Binding AuthorColor}"
                                                               FontWeight="SemiBold" FontSize="12" IsVisible="{Binding AuthorVisible}"/>

                                                    <!-- Ответ / Реплай -->
                                                    <Border BorderBrush="#2EA6FF" BorderThickness="2.5,0,0,0" Background="#121B26" CornerRadius="0,6,6,0"
                                                            Padding="8,4" Margin="0,2,0,4" Cursor="Hand" IsVisible="{Binding QuoteVisible}">
                                                        <TextBlock Text="{Binding Quote}" Foreground="#2EA6FF" FontSize="11" TextWrapping="Wrap"/>
                                                    </Border>

                                                    <!-- Фотография / превью -->
                                                    <Border CornerRadius="8" ClipToBounds="True" MaxWidth="340" MaxHeight="340"
                                                            IsVisible="{Binding ImageVisible}" Margin="0,2">
                                                        <Image Source="{Binding ImagePath, Converter={x:Static local:ThumbConverter.Instance}, ConverterParameter=340}"
                                                               Stretch="Uniform"/>
                                                    </Border>

                                                    <!-- Медиа хинт (голосовое, файл) -->
                                                    <Border Background="#242F3D" CornerRadius="6" Padding="6,4"
                                                            IsVisible="{Binding MediaVisible}" PointerPressed="Media_PointerPressed"
                                                            Tag="{Binding Id}" Cursor="Hand">
                                                        <TextBlock Text="{Binding MediaHint}" Foreground="#2EA6FF" FontSize="11" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <!-- Текст сообщения -->
                                                    <SelectableTextBlock Text="{Binding Text}" Foreground="#F5F5F5" FontSize="13"
                                                                         TextWrapping="Wrap" Margin="0,1" LineHeight="18"/>

                                                    <!-- Время и статус доставки ✓✓ справа -->
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4" Margin="6,2,0,0">
                                                        <TextBlock Text="{Binding Time}" Foreground="{Binding TimeColor}" FontSize="10"/>
                                                        <TextBlock Text="{Binding StatusIcon}" Foreground="{Binding TimeColor}" FontSize="10"
                                                                   IsVisible="{Binding StatusVisible}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Плавающая кнопка возврата вниз ↓ -->
                    <Button x:Name="ScrollDownBtn" Width="36" Height="36" CornerRadius="18"
                            Background="#1E2C3A" BorderBrush="#2B3E52" BorderThickness="1"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,16,16" IsVisible="False"
                            Click="ScrollDownBtn_Click" ToolTip.Tip="Вниз">
                        <TextBlock Text="↓" FontSize="16" FontWeight="Bold" Foreground="#2EA6FF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Panel>

                <!-- Панель ответа / редактирования -->
                <Border Grid.Row="2" x:Name="ReplyBar" Background="#17212B" CornerRadius="8" Margin="8,0,8,6"
                        BorderBrush="#2EA6FF" BorderThickness="3,0,0,0" Padding="8,4" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="ReplyText" Foreground="#2EA6FF" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Content="✕" Width="22" Height="22" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#7F8C99" BorderThickness="0" Click="CancelReply_Click"/>
                    </Grid>
                </Border>

                <!-- Панель ввода сообщения -->
                <Border Grid.Row="3" Background="#17212B" CornerRadius="18" BorderBrush="#242F3D" BorderThickness="1"
                        Padding="4,2" Margin="10,0,10,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Content="📎" Width="34" Height="34" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="Transparent" Foreground="#708499" BorderThickness="0" CornerRadius="17"
                                Click="Attach_Click" ToolTip.Tip="Прикрепить файл или фото"/>

                        <TextBox Grid.Column="1" x:Name="MsgBox" Watermark="Написать сообщение..."
                                 Background="Transparent" Foreground="#F5F5F5" BorderThickness="0"
                                 Padding="8,6" FontSize="13" MaxHeight="100"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 KeyDown="MsgBox_KeyDown"/>

                        <Button Grid.Column="2" Content="➤" Width="34" Height="34" Padding="0"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#2EA6FF" Foreground="White" BorderThickness="0" CornerRadius="17"
                                Click="Send_Click" ToolTip.Tip="Отправить (Enter)"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Строка статуса -->
        <Border Grid.Row="1" Background="#111922" Padding="10,4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" x:Name="StatusLabel" Text="Готово" FontSize="11" Foreground="#708499" VerticalAlignment="Center"/>
                <Button Grid.Column="1" x:Name="ReloginBtn" Content="Войти заново" FontSize="11"
                        Background="Transparent" Foreground="#2EA6FF" BorderThickness="0" Padding="8,2"
                        Cursor="Hand" Click="Relogin_Click" IsVisible="False"/>
            </Grid>
        </Border>
    </Grid>
</Window>
