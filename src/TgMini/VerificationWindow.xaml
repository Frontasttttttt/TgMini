<Window x:Class="TgMini.VerificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG Mini" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterScreen" Background="#0B0E13"
        WindowStyle="ToolWindow" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock x:Name="PromptText" Foreground="#E8ECF1" FontSize="13" TextWrapping="Wrap"
                   Text="Введите код из Telegram"/>
        <TextBox x:Name="ValueBox" Margin="0,12,0,12" Padding="10,8" FontSize="15"
                 Background="#1A2230" Foreground="#E8ECF1" BorderThickness="0"/>
        <Button Content="OK" Height="34" Click="Ok_Click" IsDefault="True"
                Background="#2EA6FF" Foreground="White" FontWeight="Bold" BorderThickness="0"/>
    </StackPanel>
</Window>
