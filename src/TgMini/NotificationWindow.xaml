<Window x:Class="TgMini.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG Mini Notification" Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" Focusable="False" ShowActivated="False">
    <Border Background="#F011151C" CornerRadius="12" BorderBrush="#2EA6FF" BorderThickness="1.5"
            Margin="8" Cursor="Hand" MouseLeftButtonUp="Card_Click">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.7"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Аватарка -->
                <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                        Background="{Binding AvatarColor}" VerticalAlignment="Top">
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <!-- Текст -->
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Title}" Foreground="#E8ECF1" FontSize="13" FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Text}" Foreground="#B0B8C4" FontSize="12" Margin="0,2,0,0"
                               TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Кнопка закрытия -->
                <Button Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent"
                        Foreground="#8B949E" BorderThickness="0" FontSize="11" Cursor="Hand"
                        VerticalAlignment="Top" Click="Close_Click"/>
            </Grid>
            <!-- Индикатор времени (таймер автозакрытия) -->
            <ProgressBar Grid.Row="1" x:Name="TimeoutBar" Height="2" Margin="0,8,0,0"
                         Background="#1A2230" Foreground="#2EA6FF" BorderThickness="0"
                         Minimum="0" Maximum="100" Value="100"/>
        </Grid>
    </Border>
</Window>
