<Window x:Class="TgMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TgMini"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="TG Mini" Height="640" Width="900" MinWidth="420" MinHeight="380"
        FontFamily="Segoe UI Emoji, Segoe UI"
        Background="#0E1621" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragLeave="Window_DragLeave"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <local:ThumbConverter x:Key="ThumbConv"/>

        <!-- Тонкий темный скроллбар в стиле Telegram -->
        <Style x:Key="ScrollBarRepeatBtn" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder" Background="#2E3C4D" CornerRadius="3" Margin="1,0"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#495F7A"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#2EA6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarRepeatBtn}" Command="{x:Static ScrollBar.PageUpCommand}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollBarRepeatBtn}" Command="{x:Static ScrollBar.PageDownCommand}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollBarThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="6"/>
                    <Setter Property="MinHeight" Value="6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ScrollBar}">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarRepeatBtn}" Command="{x:Static ScrollBar.PageLeftCommand}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollBarRepeatBtn}" Command="{x:Static ScrollBar.PageRightCommand}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                        <Border x:Name="HThumb" Background="#2E3C4D" CornerRadius="3" Margin="0,1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="HThumb" Property="Background" Value="#495F7A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="HThumb" Property="Background" Value="#2EA6FF"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="Background" Value="#242F3D"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2B394A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="CircleGhostBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#708499"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" Width="34" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242F3D"/>
                                <Setter Property="Foreground" Value="#2EA6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="CircleAccentBtn">
            <Setter Property="Background" Value="#2EA6FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="17" Width="34" Height="34">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B96ED"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1680CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FloatingBtn">
            <Setter Property="Background" Value="#1E2C3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2B3E52"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18" Width="36" Height="36">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Opacity="0.4" Color="Black"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26384A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2EA6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="MiniGhostBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#708499"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#242F3D"/>
                                <Setter Property="Foreground" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="FolderBtn">
            <Setter Property="Background" Value="#1E2936"/>
            <Setter Property="Foreground" Value="#708499"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="11"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#283647"/>
                                <Setter Property="Foreground" Value="#F5F5F5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox" x:Key="SeamlessBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CaretBrush" Value="#2EA6FF"/>
            <Setter Property="SelectionBrush" Value="#2EA6FF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="DialogListItemStyle">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2936"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#243343"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон строки диалога -->
        <DataTemplate x:Key="DialogRowTpl">
            <Grid Margin="4,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Круглая аватарка с инициалами или фото -->
                <Grid Grid.Column="0" Width="38" Height="38" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding AvatarColor}"/>
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Visibility="{Binding AvatarVisible}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource ThumbConv}, ConverterParameter=48}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <!-- Правая колонка: Имя, Время, Превью, Бейдж, Мут, Закреп -->
                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Имя диалога -->
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="13" Foreground="#F5F5F5"
                               FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis"/>
                    <!-- Время последнего сообщения -->
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Time}" FontSize="11" Foreground="#708499"
                               Margin="4,0,0,0"/>

                    <!-- Превью последнего сообщения -->
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding Preview}" FontSize="12" Foreground="#7F8C99"
                               TextTrimming="CharacterEllipsis" Margin="0,3,4,0"/>

                    <!-- Иконки: Закреп, Мут, Бейдж -->
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock Text="🔇" FontSize="10" Foreground="#708499" Margin="0,0,4,0"
                                   Visibility="{Binding MutedVisible}"/>
                        <TextBlock Text="📌" FontSize="11" Foreground="#2EA6FF" Margin="0,0,4,0"
                                   Visibility="{Binding PinnedVisible}"/>
                        <Border Background="{Binding BadgeBackground}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                VerticalAlignment="Center" Visibility="{Binding BadgeVisible}">
                            <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- Шаблон строки сообщения -->
        <DataTemplate x:Key="MsgRowTpl">
            <StackPanel Margin="0,2">
                <!-- Центрированный разделитель даты (например: 18 октября / Сегодня) -->
                <Border Background="#17212B" CornerRadius="10" Padding="12,3"
                        HorizontalAlignment="Center" Margin="0,4,0,6"
                        Visibility="{Binding DateSeparatorVisible}">
                    <TextBlock Text="{Binding DateSeparator}" Foreground="#7F8C99" FontSize="11" FontWeight="SemiBold"/>
                </Border>

                <!-- Сообщение в бабле -->
                <Border Background="{Binding Bubble}" CornerRadius="{Binding BubbleRadius}" Padding="10,7" Margin="4,1"
                        HorizontalAlignment="{Binding Align}">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="↩ Ответить" Click="MsgMenuReply_Click"/>
                            <MenuItem Header="✏️ Редактировать" Visibility="{Binding CanEdit}" Click="MsgMenuEdit_Click"/>
                            <MenuItem Header="💾 Сохранить как..." Visibility="{Binding MediaActionsVisible}" Click="MsgMenuSaveAs_Click"/>
                            <MenuItem Header="📂 Показать в папке" Visibility="{Binding MediaActionsVisible}" Click="MsgMenuShowInFolder_Click"/>
                            <MenuItem Header="📋 Скопировать текст" Click="MsgMenuCopy_Click"/>
                            <Separator/>
                            <MenuItem Header="🗑️ Удалить" Foreground="#FF5C7A" Click="MsgMenuDelete_Click"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel MaxWidth="{Binding WrapWidth}">
                        <!-- Автор (в группах) -->
                        <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{Binding AuthorColor}" Visibility="{Binding AuthorVisible}" Margin="0,0,0,2"/>

                        <!-- Цитата / Реплай в стиле Telegram: плашка с левой акцентной полосой -->
                        <Border BorderBrush="#2EA6FF" BorderThickness="2.5,0,0,0" Background="#121B26" CornerRadius="0,6,6,0"
                                Padding="8,4" Margin="0,2,0,4" Cursor="Hand" Visibility="{Binding QuoteVisible}"
                                Tag="{Binding Id}" MouseLeftButtonUp="Quote_Click">
                            <TextBlock Text="{Binding Quote}" FontSize="11" Foreground="#2EA6FF" TextWrapping="Wrap"/>
                        </Border>

                        <!-- Встроенное превью картинки / стикера / медиа -->
                        <Border CornerRadius="8" Margin="0,4" MaxWidth="340" MaxHeight="280"
                                Visibility="{Binding ImageVisible}" Cursor="Hand"
                                Tag="{Binding Id}" MouseLeftButtonUp="Image_Click">
                            <Image Source="{Binding ImagePath, Converter={StaticResource ThumbConv}, ConverterParameter=340}" Stretch="Uniform" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock Text="{Binding MediaHint}" FontSize="12" Foreground="#2EA6FF"
                                   Cursor="Hand" Visibility="{Binding MediaVisible}"
                                   Tag="{Binding Id}" MouseLeftButtonUp="Media_Click" Margin="0,2"/>

                        <!-- Текст сообщения -->
                        <TextBlock local:Linkifier.Text="{Binding Text}" FontSize="13" Foreground="#F5F5F5" TextWrapping="Wrap" LineHeight="18"/>

                        <!-- Нижняя строка: Время и статус прочтения (✓✓) аккуратно справа -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,2,0,0">
                            <TextBlock Text="{Binding Time}" FontSize="10" Foreground="{Binding TimeColor}"/>
                            <TextBlock Text="{Binding StatusIcon}" FontSize="10" Foreground="{Binding TimeColor}" Margin="4,0,0,0"
                                       Visibility="{Binding StatusVisible}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ КОЛОНКА: Папки, Поиск, Список чатов -->
        <Border Grid.Column="0" Background="#17212B">
            <DockPanel Margin="10,10,10,6">
                <!-- Полоса папок -->
                <WrapPanel x:Name="FolderBar" DockPanel.Dock="Top" Margin="0,0,0,8"/>

                <!-- Поле поиска -->
                <Border DockPanel.Dock="Top" Background="#242F3D" CornerRadius="14" Margin="0,0,0,8" Padding="6,3">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#708499" VerticalAlignment="Center" Margin="6,0,4,0"/>
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SearchPlaceholder" Text="Поиск..." FontSize="12" Foreground="#708499"
                                       VerticalAlignment="Center" Margin="4,0,0,0" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Style="{StaticResource SeamlessBox}" FontSize="12" Padding="4,4"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                        <Button x:Name="SearchClearBtn" Grid.Column="2" Content="✕" Width="20" Height="20"
                                Style="{StaticResource MiniGhostBtn}" Visibility="Collapsed"
                                Click="SearchClearBtn_Click"/>
                    </Grid>
                </Border>

                <!-- Список диалогов -->
                <ListBox x:Name="DialogList" Background="#17212B" Foreground="#F5F5F5"
                         BorderThickness="0" SelectionChanged="DialogList_SelectionChanged"
                         ItemTemplate="{StaticResource DialogRowTpl}"
                         ItemContainerStyle="{StaticResource DialogListItemStyle}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="DialogContextMenu_Opened">
                            <MenuItem Header="🗄️ В архив / Из архива" Click="DialogArchive_Click"/>
                            <MenuItem x:Name="MenuMute" Header="🔇 Уведомления">
                                <MenuItem x:Name="MenuMuteUnmute" Header="🔊 Включить звук" Click="DialogMute_Unmute_Click"/>
                                <Separator/>
                                <MenuItem Header="🔇 На 1 час" Click="DialogMute_1h_Click"/>
                                <MenuItem Header="🔇 На 8 часов" Click="DialogMute_8h_Click"/>
                                <MenuItem Header="🔇 На 2 дня" Click="DialogMute_2d_Click"/>
                                <MenuItem Header="🔇 Навсегда" Click="DialogMute_Forever_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="MenuFolders" Header="📁 В папку..."/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ПРАВАЯ ОБЛАСТЬ: Чат -->
        <Grid Grid.Column="1" Margin="14,10,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка чата с аватаркой, именем и статусом -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TogglePanelBtn" Content="☰" Style="{StaticResource GhostBtn}"
                        Padding="8,5" Margin="0,0,10,0" ToolTip="Компактный режим (скрыть/показать список чатов)"
                        Click="TogglePanel_Click"/>
                <!-- Аватарка выбранного чата в шапке -->
                <Grid Grid.Column="1" x:Name="HeaderAvatar" Width="36" Height="36" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed">
                    <Ellipse x:Name="HeaderAvatarBg" Fill="#2EA6FF"/>
                    <TextBlock x:Name="HeaderAvatarInitials" Text="TG" Foreground="White" FontSize="13" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse x:Name="HeaderAvatarPhoto" Visibility="Collapsed">
                        <Ellipse.Fill>
                            <ImageBrush x:Name="HeaderAvatarBrush" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="ChatTitle" Text="Выберите чат"
                               FontSize="15" FontWeight="SemiBold" Foreground="#F5F5F5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ChatSub" Text="" FontSize="11"
                               Foreground="#708499" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Лента сообщений + плавающая кнопка Вниз -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="LoadMoreBtn" Grid.Row="0" Content="⬆ Загрузить более ранние сообщения"
                        Style="{StaticResource GhostBtn}" Foreground="#2EA6FF" Margin="0,0,0,6"
                        Visibility="Collapsed" Click="LoadMore_Click"/>
                <ListBox x:Name="FeedList" Grid.Row="1" Background="#0E1621"
                         Foreground="#F5F5F5" BorderThickness="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="False"
                         ItemTemplate="{StaticResource MsgRowTpl}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

                <!-- Плавающая кнопка возврата вниз ↓ -->
                <Button x:Name="ScrollDownBtn" Grid.Row="1" Width="36" Height="36"
                        Style="{StaticResource FloatingBtn}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,16,16" Visibility="Collapsed"
                        ToolTip="Перейти к последним сообщениям"
                        Click="ScrollDownBtn_Click">
                    <TextBlock Text="↓" FontSize="16" FontWeight="Bold" Foreground="#2EA6FF" Margin="0,-2,0,0"/>
                </Button>
            </Grid>

            <!-- Полоса ответа/редактирования (Reply Bar) -->
            <Border x:Name="ReplyBar" Grid.Row="2" Background="#17212B" CornerRadius="8" Margin="0,0,0,6"
                    BorderBrush="#2EA6FF" BorderThickness="3,0,0,0" Padding="8,4" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ReplyTitle" Text="Ответ на сообщение" FontSize="11" FontWeight="SemiBold" Foreground="#2EA6FF"/>
                        <TextBlock x:Name="ReplyLabel" Foreground="#7F8C99" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="✕" Width="22" Height="22" Style="{StaticResource MiniGhostBtn}"
                            Padding="0" VerticalAlignment="Center" HorizontalAlignment="Right" Click="ReplyClear_Click"/>
                </Grid>
            </Border>

            <!-- Блок ввода сообщения -->
            <Border Grid.Row="3" Background="#17212B" CornerRadius="18" BorderBrush="#242F3D" BorderThickness="1"
                    Padding="4,2" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Кнопка прикрепления файла 📎 -->
                    <Button Content="📎" Grid.Column="0" Width="34" Height="34" Style="{StaticResource CircleGhostBtn}"
                            ToolTip="Прикрепить файл или фото" Click="Attach_Click"/>

                    <!-- Поле ввода с подсказкой Watermark -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="InputPlaceholder" Text="Написать сообщение..." FontSize="13" Foreground="#708499"
                                   Margin="8,0,0,0" IsHitTestVisible="False" VerticalAlignment="Center"/>
                        <TextBox x:Name="InputBox" Style="{StaticResource SeamlessBox}" Padding="8,6"
                                 VerticalContentAlignment="Center"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"
                                 KeyDown="InputBox_KeyDown"
                                 TextChanged="InputBox_TextChanged">
                            <TextBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="📋 Вставить (текст / фото)" Click="InputContextMenu_Paste_Click"/>
                                    <MenuItem Header="📄 Копировать" Click="InputContextMenu_Copy_Click"/>
                                    <MenuItem Header="✂️ Вырезать" Click="InputContextMenu_Cut_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑️ Очистить" Click="InputContextMenu_Clear_Click"/>
                                </ContextMenu>
                            </TextBox.ContextMenu>
                        </TextBox>
                    </Grid>

                    <!-- Кнопка отправки ➤ -->
                    <Button x:Name="SendBtn" Grid.Column="2" Width="34" Height="34" Style="{StaticResource CircleAccentBtn}"
                            ToolTip="Отправить (Enter)" Click="Send_Click">
                        <TextBlock Text="➤" FontSize="13" Margin="2,0,0,0"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Строка статуса -->
            <TextBlock x:Name="StatusLabel" Grid.Row="4" Foreground="#708499"
                       FontSize="11" Margin="4,2,0,0"/>
        </Grid>

        <!-- Дроп-зона при перетаскивании файлов (Drag & Drop) -->
        <Border x:Name="DropOverlay" Grid.ColumnSpan="2" Panel.ZIndex="990"
                Background="#E60E1621" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid Margin="24">
                <Rectangle Stroke="#2EA6FF" StrokeThickness="2" StrokeDashArray="4 2"
                           RadiusX="16" RadiusY="16" Fill="#142EA6FF"/>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📥" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Перетащите файлы сюда" FontSize="16" FontWeight="SemiBold"
                               Foreground="#2EA6FF" HorizontalAlignment="Center"/>
                    <TextBlock Text="Файлы будут отправлены в текущий чат" FontSize="12"
                               Foreground="#708499" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Полноэкранный просмотрщик изображений (In-App Lightbox) -->
        <Grid x:Name="PhotoViewerOverlay" Grid.ColumnSpan="2" Panel.ZIndex="1000"
              Background="#E6080E14" Visibility="Collapsed"
              MouseLeftButtonDown="PhotoViewerOverlay_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Верхняя панель: заголовок, инфо, сохранить, закрыть -->
            <Grid Grid.Row="0" Margin="16,12,16,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="PhotoViewerTitle" Text="Просмотр фото" Foreground="#F5F5F5"
                               FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PhotoViewerInfo" Text="" Foreground="#708499" FontSize="12" Margin="12,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="PhotoViewerSaveBtn" Content="💾 Сохранить" Style="{StaticResource MiniGhostBtn}"
                            Padding="10,6" Margin="0,0,8,0" Click="PhotoViewerSave_Click"/>
                    <Button x:Name="PhotoViewerCloseBtn" Content="✕" Width="32" Height="32" Style="{StaticResource MiniGhostBtn}"
                            FontSize="14" Click="PhotoViewerClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Контейнер изображения -->
            <Border Grid.Row="1" Margin="24,8,24,24" ClipToBounds="True">
                <Image x:Name="PhotoViewerImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
        </Grid>
    </Grid>
</Window>
