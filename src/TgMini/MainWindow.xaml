<Window x:Class="TgMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="TG Mini" Height="640" Width="900" MinWidth="560" MinHeight="400"
        Background="#0B0E13" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="Background" Value="#1A2230"/>
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202A3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="DarkBox">
            <Setter Property="Background" Value="#1A2230"/>
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <DataTemplate x:Key="DialogRowTpl">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8ECF1"
                               FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#8B949E"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2EA6FF" CornerRadius="8" Padding="7,1"
                        VerticalAlignment="Center" Visibility="{Binding BadgeVisible}">
                    <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MsgRowTpl">
            <Border Background="{Binding Bubble}" CornerRadius="10" Padding="10,7" Margin="4,2"
                    HorizontalAlignment="{Binding Align}">
                <StackPanel MaxWidth="{Binding WrapWidth}">
                    <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="Bold"
                               Foreground="{Binding AuthorColor}" Visibility="{Binding AuthorVisible}"/>
                    <TextBlock Text="{Binding Quote}" FontSize="11" Foreground="#2EA6FF"
                               TextWrapping="Wrap" Cursor="Hand" Visibility="{Binding QuoteVisible}"
                               Tag="{Binding Id}" MouseLeftButtonUp="Quote_Click"/>
                    <TextBlock Text="{Binding MediaHint}" FontSize="12" Foreground="#2EA6FF"
                               Cursor="Hand" Visibility="{Binding MediaVisible}"
                               Tag="{Binding Id}" MouseLeftButtonUp="Media_Click"/>
                    <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#E8ECF1" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#8B949E"/>
                        <TextBlock Text="  reply" FontSize="10" Foreground="#2EA6FF" Cursor="Hand"
                                   Tag="{Binding Id}" MouseLeftButtonUp="Reply_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#11151C">
            <DockPanel Margin="10">
                <WrapPanel x:Name="FolderBar" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource DarkBox}"
                         Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>
                <ListBox x:Name="DialogList" Background="#11151C" Foreground="#E8ECF1"
                         BorderThickness="0" SelectionChanged="DialogList_SelectionChanged"
                         ItemTemplate="{StaticResource DialogRowTpl}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1" Margin="14,12,14,10">
            <TextBlock x:Name="ChatTitle" DockPanel.Dock="Top" Text="Select chat"
                       FontSize="16" FontWeight="Bold" Foreground="#E8ECF1"/>
            <TextBlock x:Name="ChatSub" DockPanel.Dock="Top" Text="" FontSize="11"
                       Foreground="#8B949E" Margin="0,0,0,8"/>
            <ListBox x:Name="FeedList" DockPanel.Dock="Top" Background="#0B0E13"
                     Foreground="#E8ECF1" BorderThickness="0" Margin="0,0,0,10"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     ItemTemplate="{StaticResource MsgRowTpl}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <StackPanel x:Name="ReplyBar" DockPanel.Dock="Top" Orientation="Horizontal"
                        Background="#1A2230" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock x:Name="ReplyLabel" Foreground="#8B949E" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="10,6,0,6"/>
                <Button Content="X" Style="{StaticResource GhostBtn}" Margin="4,2"
                        Click="ReplyClear_Click"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom">
                <Button Content="Send" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}"
                        Background="#2EA6FF" Foreground="White" FontWeight="Bold"
                        Margin="8,0,0,0" Padding="16,6" Click="Send_Click"/>
                <Button Content="+" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}"
                        Margin="8,0,0,0" Click="Attach_Click"/>
                <TextBox x:Name="InputBox" Style="{StaticResource DarkBox}" Padding="10,8"
                         VerticalContentAlignment="Center" KeyDown="InputBox_KeyDown"/>
            </DockPanel>
            <TextBlock x:Name="StatusLabel" DockPanel.Dock="Bottom" Foreground="#8B949E"
                       FontSize="11" Margin="0,4,0,0"/>
        </DockPanel>
    </Grid>
</Window>
