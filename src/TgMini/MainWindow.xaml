<Window x:Class="TgMini.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TgMini"
        mc:Ignorable="d" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="TG Mini" Height="640" Width="900" MinWidth="360" MinHeight="360"
        FontFamily="Segoe UI Emoji, Segoe UI"
        Icon="app.ico"
        Background="#0B0E13" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ThumbConverter x:Key="ThumbConv"/>
        <Style TargetType="Button" x:Key="GhostBtn">
            <Setter Property="Background" Value="#1A2230"/>
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#202A3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox" x:Key="DarkBox">
            <Setter Property="Background" Value="#1A2230"/>
            <Setter Property="Foreground" Value="#E8ECF1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <DataTemplate x:Key="DialogRowTpl">
            <Grid Margin="2,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Круглая аватарка с инициалами или фото -->
                <Grid Grid.Column="0" Width="34" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Ellipse Fill="{Binding AvatarColor}"/>
                    <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Ellipse Visibility="{Binding AvatarVisible}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding AvatarPath, Converter={StaticResource ThumbConv}, ConverterParameter=48}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8ECF1"
                               FontWeight="{Binding NameWeight}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="#8B949E"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📌" FontSize="11" Foreground="#8B949E" Margin="0,0,4,0"
                               Visibility="{Binding PinnedVisible}"/>
                    <Border Background="#2EA6FF" CornerRadius="8" Padding="7,1"
                            VerticalAlignment="Center" Visibility="{Binding BadgeVisible}">
                        <TextBlock Text="{Binding Unread}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="MsgRowTpl">
            <Border Background="{Binding Bubble}" CornerRadius="10" Padding="10,7" Margin="4,2"
                    HorizontalAlignment="{Binding Align}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="↩ Ответить" Click="MsgMenuReply_Click"/>
                        <MenuItem Header="✏️ Редактировать" Visibility="{Binding CanEdit}" Click="MsgMenuEdit_Click"/>
                        <MenuItem Header="💾 Сохранить как..." Visibility="{Binding MediaActionsVisible}" Click="MsgMenuSaveAs_Click"/>
                        <MenuItem Header="📂 Показать в папке" Visibility="{Binding MediaActionsVisible}" Click="MsgMenuShowInFolder_Click"/>
                        <MenuItem Header="📋 Скопировать текст" Click="MsgMenuCopy_Click"/>
                        <Separator/>
                        <MenuItem Header="🗑️ Удалить" Foreground="#FF5C7A" Click="MsgMenuDelete_Click"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel MaxWidth="{Binding WrapWidth}">
                    <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="Bold"
                               Foreground="{Binding AuthorColor}" Visibility="{Binding AuthorVisible}"/>
                    <TextBlock Text="{Binding Quote}" FontSize="11" Foreground="#2EA6FF"
                               TextWrapping="Wrap" Cursor="Hand" Visibility="{Binding QuoteVisible}"
                               Tag="{Binding Id}" MouseLeftButtonUp="Quote_Click"/>
                    <!-- Встроенное превью картинки / стикера / кружочка с ограничением 340px для экономии RAM -->
                    <Border CornerRadius="8" Margin="0,4" MaxWidth="340" MaxHeight="280"
                            Visibility="{Binding ImageVisible}" Cursor="Hand"
                            Tag="{Binding Id}" MouseLeftButtonUp="Image_Click">
                        <Image Source="{Binding ImagePath, Converter={StaticResource ThumbConv}, ConverterParameter=340}" Stretch="Uniform" HorizontalAlignment="Left"/>
                    </Border>
                    <TextBlock Text="{Binding MediaHint}" FontSize="12" Foreground="#2EA6FF"
                               Cursor="Hand" Visibility="{Binding MediaVisible}"
                               Tag="{Binding Id}" MouseLeftButtonUp="Media_Click"/>
                    <TextBlock local:Linkifier.Text="{Binding Text}" FontSize="13" Foreground="#E8ECF1" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Time}" FontSize="10" Foreground="#8B949E"/>
                        <TextBlock Text="  reply" FontSize="10" Foreground="#2EA6FF" Cursor="Hand"
                                   Tag="{Binding Id}" MouseLeftButtonUp="Reply_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#11151C">
            <DockPanel Margin="10">
                <WrapPanel x:Name="FolderBar" DockPanel.Dock="Top" Margin="0,0,0,8"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource DarkBox}"
                         Margin="0,0,0,8" TextChanged="SearchBox_TextChanged"/>
                <ListBox x:Name="DialogList" Background="#11151C" Foreground="#E8ECF1"
                         BorderThickness="0" SelectionChanged="DialogList_SelectionChanged"
                         ItemTemplate="{StaticResource DialogRowTpl}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="DialogContextMenu_Opened">
                            <MenuItem Header="🗄️ В архив / Из архива" Click="DialogArchive_Click"/>
                            <MenuItem x:Name="MenuMute" Header="🔇 Уведомления">
                                <MenuItem x:Name="MenuMuteUnmute" Header="🔊 Включить звук" Click="DialogMute_Unmute_Click"/>
                                <Separator/>
                                <MenuItem Header="🔇 На 1 час" Click="DialogMute_1h_Click"/>
                                <MenuItem Header="🔇 На 8 часов" Click="DialogMute_8h_Click"/>
                                <MenuItem Header="🔇 На 2 дня" Click="DialogMute_2d_Click"/>
                                <MenuItem Header="🔇 Навсегда" Click="DialogMute_Forever_Click"/>
                            </MenuItem>
                            <MenuItem x:Name="MenuFolders" Header="📁 В папку..."/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TogglePanelBtn" Content="☰" Style="{StaticResource GhostBtn}"
                        Padding="7,3" Margin="0,0,10,0" ToolTip="Компактный режим (скрыть/показать список чатов)"
                        Click="TogglePanel_Click"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ChatTitle" Text="Select chat"
                               FontSize="16" FontWeight="Bold" Foreground="#E8ECF1"/>
                    <TextBlock x:Name="ChatSub" Text="" FontSize="11"
                               Foreground="#8B949E"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="LoadMoreBtn" Grid.Row="0" Content="⬆ Загрузить более ранние сообщения"
                        Style="{StaticResource GhostBtn}" Foreground="#2EA6FF" Margin="0,0,0,6"
                        Visibility="Collapsed" Click="LoadMore_Click"/>
                <ListBox x:Name="FeedList" Grid.Row="1" Background="#0B0E13"
                         Foreground="#E8ECF1" BorderThickness="0"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="False"
                         ItemTemplate="{StaticResource MsgRowTpl}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>
            <StackPanel x:Name="ReplyBar" Grid.Row="2" Orientation="Horizontal"
                        Background="#1A2230" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock x:Name="ReplyLabel" Foreground="#8B949E" FontStyle="Italic"
                           VerticalAlignment="Center" Margin="10,6,0,6"/>
                <Button Content="X" Style="{StaticResource GhostBtn}" Margin="4,2"
                        Click="ReplyClear_Click"/>
            </StackPanel>
            <DockPanel Grid.Row="3" Margin="0,0,0,4">
                <Button Content="Send" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}"
                        Background="#2EA6FF" Foreground="White" FontWeight="Bold"
                        Margin="8,0,0,0" Padding="16,6" Click="Send_Click"/>
                <Button Content="+" DockPanel.Dock="Right" Style="{StaticResource GhostBtn}"
                        Margin="8,0,0,0" Click="Attach_Click"/>
                <TextBox x:Name="InputBox" Style="{StaticResource DarkBox}" Padding="10,8"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="InputBox_PreviewKeyDown"
                         KeyDown="InputBox_KeyDown">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="📋 Вставить (текст / фото)" Click="InputContextMenu_Paste_Click"/>
                            <MenuItem Header="📄 Копировать" Click="InputContextMenu_Copy_Click"/>
                            <MenuItem Header="✂️ Вырезать" Click="InputContextMenu_Cut_Click"/>
                            <Separator/>
                            <MenuItem Header="🗑️ Очистить" Click="InputContextMenu_Clear_Click"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </DockPanel>
            <TextBlock x:Name="StatusLabel" Grid.Row="4" Foreground="#8B949E"
                       FontSize="11" Margin="0,2,0,0"/>
        </Grid>
    </Grid>
</Window>
