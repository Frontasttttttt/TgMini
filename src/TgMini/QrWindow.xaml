<Window x:Class="TgMini.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TG Mini — вход по QR" SizeToContent="Height" Width="360"
        WindowStartupLocation="CenterScreen" Background="#0B0E13"
        WindowStyle="ToolWindow" ResizeMode="NoResize">
    <StackPanel Margin="18">
        <TextBlock Foreground="#E8ECF1" FontSize="13" TextWrapping="Wrap"
                   Text="Откройте официальный Telegram → Настройки → Устройства → Подключить устройство и наведите камеру на код:"/>
        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,12">
            <Image x:Name="QrImage" Width="240" Height="240"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="QrStatus" Foreground="#8B949E" FontSize="12" TextWrapping="Wrap"
                   Text="Ожидание сканирования..."/>
        <Button Content="Отмена" Margin="0,12,0,0" Height="32" Click="Cancel_Click"
                Background="#1A2230" Foreground="#E8ECF1" BorderThickness="0"/>
    </StackPanel>
</Window>
